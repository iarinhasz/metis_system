# Django
METIS_SECRET_KEY=change-this-before-deploying
METIS_DEBUG=true
# Mantenha 127.0.0.1: o healthcheck do container chama o /health/ por ele.
METIS_ALLOWED_HOSTS=localhost,127.0.0.1
METIS_CSRF_TRUSTED_ORIGINS=

# Local services
# Valores para rodar manage.py e pytest no host. No docker compose, host, porta, Redis e
# MEDIA_ROOT são trocados pelos serviços internos (x-common-env do docker-compose.yml).
METIS_POSTGRES_HOST=localhost
METIS_POSTGRES_PORT=5440
METIS_POSTGRES_DB=metis
METIS_POSTGRES_USER=metis
METIS_POSTGRES_PASSWORD=metis
METIS_REDIS_URL=redis://localhost:6379/0
# Token do sistema que submete os artigos; vazio deixa a API bloqueada.
METIS_API_TOKEN=
METIS_MEDIA_ROOT=media
METIS_MAX_UPLOAD_MB=50

# Taxonomia OpenAlex (2.1): chave opcional; --file permite carga sem rede.
METIS_OPENALEX_API_KEY=

# Pipeline timing (seconds)
METIS_STAGE_MAX_RETRIES=3
METIS_STAGE_RETRY_BACKOFF_SECONDS=60
METIS_STAGE_RETRY_BACKOFF_MAX_SECONDS=900
METIS_STAGE_SOFT_TIME_LIMIT_SECONDS=1500
METIS_STAGE_TIME_LIMIT_SECONDS=1800
METIS_BROKER_VISIBILITY_TIMEOUT_SECONDS=7200
METIS_RECONCILE_INTERVAL_SECONDS=300
METIS_REPUBLISH_AFTER_SECONDS=900
METIS_STALE_STAGE_AFTER_SECONDS=2700
METIS_MAX_REPUBLISH=3
METIS_MAX_STAGE_CLAIMS=8

# Modelo de linguagem (E1). A chave do Gemini vem sem o prefixo METIS_.
GEMINI_KEY=
METIS_LLM_TIMEOUT_SECONDS=600

# Spike do Agno (1.2): testes `llm` usam apenas texto sintético.
METIS_OPENAI_API_KEY=
METIS_AGNO_CONTRACT_OPENAI_MODEL=gpt-4o-mini
METIS_AGNO_CONTRACT_GOOGLE_MODEL=gemini-2.5-flash
# Catálogo 1.3: padrões de desenvolvimento, substituíveis por papel.
# Cada campo também aceita JSON, por exemplo:
# METIS_EVALUATOR_C={"provider":"google","family":"gemini","model_id":"gemini-3.5-flash-lite"}
METIS_EVALUATOR_A__MODEL_ID=gpt-5.6-terra
METIS_EVALUATOR_B__MODEL_ID=gemini-3.8-flash
METIS_EVALUATOR_C__MODEL_ID=gpt-5.6-luna
METIS_JUDGE_OPENAI__MODEL_ID=gpt-5.6-terra
METIS_JUDGE_GOOGLE__MODEL_ID=gemini-3.8-flash
METIS_META_REVIEWER__MODEL_ID=gpt-5.6-terra
METIS_VISION__MODEL_ID=gemini-3.5-flash-lite
METIS_FAST__MODEL_ID=gemini-3.5-flash-lite
METIS_ADJUDICATOR__MODEL_ID=gemini-3.8-flash
METIS_LLM_MAX_CONCURRENCY=4
# Alternativa à GEMINI_KEY; quando preenchida, tem precedência nas novas fábricas.
METIS_GOOGLE_API_KEY=
# O Agno lê esta variável do ambiente do processo; exporte-a também ao rodar fora do compose.
AGNO_TELEMETRY=false

# Docker compose: portas publicadas no host (lidas só pelo compose)
METIS_WEB_PORT=8100
METIS_FLOWER_PORT=5556
# Igual a METIS_POSTGRES_PORT, para o manage.py e o pytest do host usarem o banco do compose.
METIS_POSTGRES_PUBLISHED_PORT=5440
